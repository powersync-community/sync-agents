PS_PORT=8080
PS_TELEMETRY_PORT=9090
PS_API_TOKEN=super-secret
PS_HS256_KEY=123

# Supabase local project id is "syncagents" (from supabase/config.toml)
PS_BACKEND_JWKS_URI=http://supabase_kong_syncagents:8000/auth/v1/.well-known/jwks.json

# Source DB: Supabase Postgres
PS_DATA_SOURCE_TYPE=postgresql
PS_DATA_SOURCE_URI=postgresql://postgres:postgres@supabase_db_syncagents:5432/postgres

# Sync bucket DB: PostgreSQL
PS_SYNC_BUCKET_TYPE=postgresql
PS_SYNC_BUCKET_URI=postgresql://postgres:postgres@supabase_db_syncagents:5432/postgres
